/* ============================================================
   DennokoworksToolImporterWindow.uss
   Tool Importer 固有のスタイル定義 (コンパクト高密度表示)
   すべてのセレクタに .dennoko-root を前置すること。
   ============================================================ */

/* ─── コンパクト表示: テーマ既定値の上書き ──────────────────
   DennokoTheme.uss はテンプレートのまま保ち、標準コンポーネントと同等の
   高密度・コンパクトなレイアウトを実現するためここで上書きする。 */
.dennoko-root .unity-text-element {
    font-size: 10.5px;
}

.dennoko-root .unity-button {
    padding: 1px 5px;
    margin: 1px 2px;
}

.dennoko-root .unity-button.dennoko-button-primary {
    font-size: 11px;
    height: 22px;
}

.dennoko-root .unity-button.dennoko-button-secondary {
    font-size: 9.5px;
    height: 20px;
}

.dennoko-root .unity-base-field__input {
    padding: 1px 4px;
    min-height: 18px;
    font-size: 10px;
}

.dennoko-root .dennoko-card {
    padding: 3px 5px;
    margin: 0 3px 3px 3px;
    border-radius: 4px;
}

.dennoko-root .dennoko-card-header {
    padding-bottom: 2px;
    margin-bottom: 4px;
}

.dennoko-root .dennoko-header {
    padding: 2px 6px;
    min-height: 22px;
}

.dennoko-root .dennoko-separator {
    margin: 1px 0;
}

.dennoko-root .dennoko-title {
    font-size: 12px;
}

.dennoko-root .dennoko-version-label {
    font-size: 9px;
    margin-left: 4px;
}

.dennoko-root .dennoko-version-reload-button {
    font-size: 11px;
    width: 16px;
    height: 16px;
    margin-left: 2px;
}

.dennoko-root .dennoko-section-title .unity-text-element {
    font-size: 9px;
}

.dennoko-root .dennoko-status {
    font-size: 9px;
    padding: 1px 4px;
    min-height: 15px;
}

/* ─── 汎用: 伸びて縮む (flex-grow と flex-shrink は必ずセット) ─ */
.dennoko-root .dennoko-col-grow {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

/* ─── ヘッダー ─────────────────────────────────────────── */
.dennoko-root .header-button {
    height: 20px;
    padding: 0 5px;
    font-size: 10px;
    margin: 1px 2px;
}

.dennoko-root .dennoko-lang-button {
    min-width: 26px;
    height: 18px;
    padding: 0 2px;
    font-size: 9px;
    -unity-font-style: bold;
    color: var(--dennoko-text-primary);
    background-color: var(--dennoko-surface-2);
    border-color: var(--dennoko-outline);
    border-width: 1px;
    border-radius: 3px;
    margin-left: 4px;
}

.dennoko-root .dennoko-lang-button:hover {
    background-color: var(--dennoko-outline);
}

/* ─── サブツールバー行 (ショップ指定・＋・マニュアル・設定) ─ */
.dennoko-root .sub-toolbar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 1px 4px;
    background-color: var(--dennoko-surface-1);
    border-bottom-width: 1px;
    border-bottom-color: var(--dennoko-outline);
    flex-shrink: 0;
    min-height: 22px;
}

.dennoko-root .shop-bar-left {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.dennoko-root .shop-prefix-label {
    font-size: 10px;
    color: var(--dennoko-text-tertiary);
    margin-right: 2px;
    flex-shrink: 0;
}

.dennoko-root .shop-select-button {
    height: 20px;
    min-width: 100px;
    max-width: 200px;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
    padding: 0 4px;
}

.dennoko-root .mini-icon-button {
    min-width: 20px;
    height: 20px;
    padding: 0 2px;
}

.dennoko-root .shop-bar-right {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 4px;
}

/* ─── 設定カード ───────────────────────────────────────── */
.dennoko-root .settings-card {
    margin-top: 2px;
    margin-bottom: 4px;
    padding: 3px 5px;
}

.dennoko-root .setting-row {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
    margin-bottom: 1px;
}

.dennoko-root .setting-label {
    width: 110px;
    min-width: 110px;
    color: var(--dennoko-text-secondary);
    font-size: 9.5px;
    -unity-text-align: middle-left;
}

.dennoko-root .setting-value {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    color: var(--dennoko-text-primary);
    background-color: var(--dennoko-surface-2);
    border-color: var(--dennoko-outline);
    border-width: 1px;
    border-radius: 3px;
    padding: 1px 3px;
    font-size: 9.5px;
    white-space: nowrap;
}

.dennoko-root .setting-status {
    width: 50px;
    min-width: 50px;
    margin-left: 4px;
    font-size: 8.5px;
    color: var(--dennoko-text-tertiary);
    -unity-text-align: middle-center;
}

/* ─── エラーバナー ─────────────────────────────────────── */
.dennoko-root .error-banner {
    background-color: var(--dennoko-status-error-bg);
    border-color: var(--dennoko-semantic-error);
    border-width: 1px;
    border-radius: 4px;
    padding: 3px 5px;
    margin: 2px 4px;
    flex-shrink: 0;
}

.dennoko-root .error-banner-text {
    color: var(--dennoko-status-error-text);
    font-size: 9.5px;
    white-space: normal;
}

/* ─── キュー進行状況カード ─────────────────────────────── */
.dennoko-root .queue-card {
    margin-top: 2px;
    margin-bottom: 4px;
    padding: 3px 5px;
    flex-shrink: 0;
}

.dennoko-root .queue-progress-bar {
    height: 16px;
    border-radius: 3px;
    margin-bottom: 3px;
    font-size: 9.5px;
}

.dennoko-root .queue-actions-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

/* ─── 操作バー ─────────────────────────────────────────── */
.dennoko-root .action-bar {
    padding: 1px 4px;
    flex-shrink: 0;
}

.dennoko-root .action-bar-row1 {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.dennoko-root .action-bar-row2 {
    flex-direction: row;
    align-items: center;
}

.dennoko-root .search-field {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 4px;
    margin-top: 0;
    margin-bottom: 0;
    font-size: 10px;
}

.dennoko-root .search-field .unity-base-field__label {
    min-width: 28px;
    font-size: 10px;
    color: var(--dennoko-text-secondary);
    padding: 0;
    margin-right: 2px;
}

.dennoko-root .search-field .unity-base-field__input {
    height: 19px;
    min-height: 19px;
    padding: 0 4px;
    font-size: 10px;
}

.dennoko-root .import-filter-button {
    flex-shrink: 0;
    margin-left: 0;
    margin-right: 8px;
}

.dennoko-root .multi-select-toggle {
    margin-left: 2px;
    margin-top: 0;
    margin-bottom: 0;
    flex-shrink: 0;
    font-size: 10px;
}

.dennoko-root .multi-select-toggle .unity-toggle__text {
    font-size: 10px;
    margin-left: 3px;
}

.dennoko-root .multi-select-toggle .unity-toggle__checkmark {
    width: 13px;
    height: 13px;
}

/* ─── バッチ操作バー ───────────────────────────────────── */
.dennoko-root .batch-bar {
    background-color: var(--dennoko-surface-1);
    border-color: var(--dennoko-outline);
    border-width: 1px;
    border-radius: 4px;
    padding: 2px 4px;
    margin: 0 3px 3px 3px;
    flex-shrink: 0;
}

.dennoko-root .batch-bar-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2px;
}

.dennoko-root .batch-import-button {
    height: 22px;
    font-size: 10px;
    -unity-font-style: bold;
    background-color: var(--dennoko-surface-2);
    color: var(--dennoko-text-primary);
    margin: 1px 0 0 0;
}

.dennoko-root .batch-import-button:hover {
    background-color: var(--dennoko-outline);
}

/* ─── アイテム一覧ヘッダー ─────────────────────────────── */
.dennoko-root .items-header-row {
    flex-direction: row;
    align-items: center;
    padding: 1px 4px;
    flex-shrink: 0;
}

.dennoko-root .items-header-title {
    font-size: 10.5px;
    -unity-font-style: bold;
    color: var(--dennoko-text-primary);
}

.dennoko-root .items-warning-container {
    flex-direction: row;
    align-items: center;
    margin-left: 4px;
    padding: 0 3px;
    border-radius: 3px;
    background-color: var(--dennoko-status-warning-bg);
}

.dennoko-root .items-warning-icon {
    width: 12px;
    height: 12px;
    margin-right: 2px;
    flex-shrink: 0;
}

.dennoko-root .items-warning-count {
    color: var(--dennoko-semantic-warning);
    font-size: 9px;
    -unity-font-style: bold;
}

/* ─── アイテム一覧 (ListView) ──────────────────────────────
   行の背景はカード側で描くため、ListView 既定の行背景・ホバー色
   (エディタテーマ依存) を打ち消す */
.dennoko-root .items-list-view {
    background-color: var(--dennoko-surface-0);
}

.dennoko-root .items-list-view .unity-collection-view__item,
.dennoko-root .items-list-view .unity-collection-view__item:hover,
.dennoko-root .items-list-view .unity-collection-view__item:checked {
    background-color: var(--dennoko-surface-0);
}

/* ─── アイテムカード (標準 helpBox に匹敵するコンパクト設計) ─ */
.dennoko-root .item-card {
    flex-direction: row;
    background-color: var(--dennoko-surface-1);
    border-color: var(--dennoko-outline);
    border-width: 1px;
    border-radius: 3px;
    padding: 2px 3px;
    margin: 1px 2px;
}

.dennoko-root .item-card-checkbox {
    margin-right: 4px;
    align-self: center;
    flex-shrink: 0;
}

.dennoko-root .item-card-checkbox .unity-toggle__checkmark {
    width: 13px;
    height: 13px;
}

.dennoko-root .item-thumbnail {
    width: 56px;
    min-width: 56px;
    max-width: 56px;
    height: 56px;
    min-height: 56px;
    max-height: 56px;
    border-radius: 3px;
    background-color: var(--dennoko-surface-2);
    margin-right: 5px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.dennoko-root .item-body {
    flex-grow: 1;
    flex-shrink: 1;
    justify-content: space-between;
    overflow: hidden;
}

.dennoko-root .item-title {
    font-size: 10.5px;
    -unity-font-style: bold;
    color: var(--dennoko-text-primary);
    white-space: normal;
    margin-bottom: 1px;
}

.dennoko-root .item-sub-label {
    font-size: 8.5px;
    color: var(--dennoko-text-tertiary);
    margin-top: 0;
    margin-bottom: 1px;
    white-space: normal;
}

.dennoko-root .item-version-box {
    background-color: var(--dennoko-status-info-bg);
    border-color: var(--dennoko-semantic-info);
    border-width: 1px;
    border-radius: 3px;
    padding: 1px 3px;
    margin-top: 2px;
    margin-bottom: 2px;
}

.dennoko-root .item-version-text {
    font-size: 8.5px;
    color: var(--dennoko-text-primary);
    white-space: normal;
}

.dennoko-root .item-actions-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 1px;
}

.dennoko-root .item-actions-left {
    flex-direction: row;
    align-items: center;
}

.dennoko-root .mini-button {
    height: 19px;
    font-size: 9px;
    padding: 0 4px;
    margin: 0 2px 0 0;
    border-radius: 3px;
}

/* インポートボタン（通常・更新・再インポート） */
.dennoko-root .import-button {
    min-width: 105px;
    height: 20px;
    font-size: 9.5px;
    -unity-font-style: bold;
    padding: 0 5px;
    margin: 0;
    border-radius: 3px;
}

.dennoko-root .import-button-new {
    color: var(--dennoko-text-primary);
}

.dennoko-root .import-button-update {
    border-color: var(--dennoko-semantic-warning);
    color: var(--dennoko-semantic-warning);
    background-color: var(--dennoko-status-warning-bg);
}

.dennoko-root .import-button-reimport {
    color: var(--dennoko-text-secondary);
}

/* ─── その他導入済みツールカード ───────────────────────── */
.dennoko-root .other-tools-header {
    margin-top: 6px;
    margin-bottom: 1px;
    padding: 1px 4px;
    font-size: 10.5px;
    -unity-font-style: bold;
    color: var(--dennoko-text-primary);
    flex-shrink: 0;
}

/* ─── 空表示メッセージ ─────────────────────────────────── */
.dennoko-root .empty-message-card {
    background-color: var(--dennoko-surface-1);
    border-color: var(--dennoko-outline);
    border-width: 1px;
    border-radius: 4px;
    padding: 6px 5px;
    margin: 6px 4px;
    align-items: center;
    flex-shrink: 0;
}

.dennoko-root .empty-message-text {
    color: var(--dennoko-text-secondary);
    font-size: 9.5px;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ─── フッター ─────────────────────────────────────────── */
.dennoko-root .dennoko-footer {
    padding: 2px 3px;
    margin: 2px 2px 1px 2px;
    border-radius: 3px;
}

.dennoko-root .dennoko-footer > .unity-button {
    height: 20px;
    font-size: 10px;
    padding: 0 6px;
    margin: 0;
}
