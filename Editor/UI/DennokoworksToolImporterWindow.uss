/* ============================================================
   DennokoworksToolImporterWindow.uss
   Tool Importer 固有のスタイル定義
   すべてのセレクタに .dennoko-root を前置すること。
   ============================================================ */

/* ─── 汎用: 伸びて縮む (flex-grow と flex-shrink は必ずセット) ─ */
.dennoko-root .dennoko-col-grow {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

/* ─── ヘッダー ─────────────────────────────────────────── */
.dennoko-root .header-button {
    height: 24px;
    padding: 2px 8px;
    font-size: 11px;
    margin-left: 4px;
    margin-right: 0;
}

.dennoko-root .dennoko-lang-button {
    min-width: 34px;
    height: 22px;
    padding: 0 6px;
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--dennoko-text-primary);
    background-color: var(--dennoko-surface-2);
    border-color: var(--dennoko-outline);
    border-width: 1px;
    border-radius: 4px;
    margin-left: 6px;
}

.dennoko-root .dennoko-lang-button:hover {
    background-color: var(--dennoko-outline);
}

/* ─── サブツールバー行 (ショップ指定・＋・マニュアル・設定) ─ */
.dennoko-root .sub-toolbar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 3px 8px;
    background-color: var(--dennoko-surface-1);
    border-bottom-width: 1px;
    border-bottom-color: var(--dennoko-outline);
    flex-shrink: 0;
}

.dennoko-root .shop-bar-left {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.dennoko-root .shop-prefix-label {
    font-size: 11px;
    color: var(--dennoko-text-tertiary);
    margin-right: 4px;
    flex-shrink: 0;
}

.dennoko-root .shop-select-button {
    min-width: 110px;
    max-width: 220px;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

.dennoko-root .mini-icon-button {
    min-width: 24px;
    padding: 0 4px;
}

.dennoko-root .shop-bar-right {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 6px;
}

/* ─── 設定カード ───────────────────────────────────────── */
.dennoko-root .settings-card {
    margin-top: 4px;
    margin-bottom: 6px;
    padding: 8px 10px;
}

.dennoko-root .setting-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
    margin-bottom: 2px;
}

.dennoko-root .setting-label {
    width: 130px;
    min-width: 130px;
    color: var(--dennoko-text-secondary);
    font-size: 11px;
    -unity-text-align: middle-left;
}

.dennoko-root .setting-value {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    color: var(--dennoko-text-primary);
    background-color: var(--dennoko-surface-2);
    border-color: var(--dennoko-outline);
    border-width: 1px;
    border-radius: 4px;
    padding: 3px 6px;
    font-size: 11px;
    white-space: nowrap;
}

.dennoko-root .setting-status {
    width: 60px;
    min-width: 60px;
    margin-left: 6px;
    font-size: 10px;
    color: var(--dennoko-text-tertiary);
    -unity-text-align: middle-center;
}

/* ─── エラーバナー ─────────────────────────────────────── */
.dennoko-root .error-banner {
    background-color: var(--dennoko-status-error-bg);
    border-color: var(--dennoko-semantic-error);
    border-width: 1px;
    border-radius: 6px;
    padding: 8px 10px;
    margin: 4px 8px;
    flex-shrink: 0;
}

.dennoko-root .error-banner-text {
    color: var(--dennoko-status-error-text);
    font-size: 11px;
    white-space: normal;
}

/* ─── キュー進行状況カード ─────────────────────────────── */
.dennoko-root .queue-card {
    margin-top: 4px;
    margin-bottom: 6px;
    padding: 8px 10px;
    flex-shrink: 0;
}

.dennoko-root .queue-progress-bar {
    height: 18px;
    border-radius: 4px;
    margin-bottom: 4px;
}

.dennoko-root .queue-actions-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

/* ─── 操作バー ─────────────────────────────────────────── */
.dennoko-root .action-bar {
    padding: 6px 8px;
    flex-shrink: 0;
}

.dennoko-root .action-bar-row1 {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.dennoko-root .action-bar-row2 {
    flex-direction: row;
    align-items: center;
}

.dennoko-root .search-field {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 8px;
}

.dennoko-root .multi-select-toggle {
    margin-left: 4px;
    flex-shrink: 0;
}

/* ─── バッチ操作バー ───────────────────────────────────── */
.dennoko-root .batch-bar {
    background-color: var(--dennoko-surface-1);
    border-color: var(--dennoko-outline);
    border-width: 1px;
    border-radius: 6px;
    padding: 6px 8px;
    margin: 0 8px 6px 8px;
    flex-shrink: 0;
}

.dennoko-root .batch-bar-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
}

.dennoko-root .batch-import-button {
    height: 28px;
    -unity-font-style: bold;
    background-color: var(--dennoko-surface-2);
    color: var(--dennoko-text-primary);
}

.dennoko-root .batch-import-button:hover {
    background-color: var(--dennoko-outline);
}

/* ─── アイテム一覧ヘッダー ─────────────────────────────── */
.dennoko-root .items-header-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 10px;
    flex-shrink: 0;
}

.dennoko-root .items-header-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--dennoko-text-primary);
}

.dennoko-root .items-warning-container {
    flex-direction: row;
    align-items: center;
    margin-left: 8px;
    padding: 1px 5px;
    border-radius: 4px;
    background-color: var(--dennoko-status-warning-bg);
}

.dennoko-root .items-warning-icon {
    width: 14px;
    height: 14px;
    margin-right: 3px;
    flex-shrink: 0;
}

.dennoko-root .items-warning-count {
    color: var(--dennoko-semantic-warning);
    font-size: 11px;
    -unity-font-style: bold;
}

/* ─── アイテムカード ───────────────────────────────────── */
.dennoko-root .item-card {
    flex-direction: row;
    background-color: var(--dennoko-surface-1);
    border-color: var(--dennoko-outline);
    border-width: 1px;
    border-radius: 6px;
    padding: 8px 10px;
    margin: 3px 8px;
}

.dennoko-root .item-card-checkbox {
    margin-right: 6px;
    align-self: center;
    flex-shrink: 0;
}

.dennoko-root .item-thumbnail {
    width: 64px;
    min-width: 64px;
    max-width: 64px;
    height: 64px;
    min-height: 64px;
    max-height: 64px;
    border-radius: 4px;
    background-color: var(--dennoko-surface-2);
    margin-right: 10px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.dennoko-root .item-body {
    flex-grow: 1;
    flex-shrink: 1;
    justify-content: space-between;
    overflow: hidden;
}

.dennoko-root .item-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--dennoko-text-primary);
    white-space: normal;
}

.dennoko-root .item-sub-label {
    font-size: 10px;
    color: var(--dennoko-text-tertiary);
    margin-top: 1px;
    white-space: normal;
}

.dennoko-root .item-version-box {
    background-color: var(--dennoko-status-info-bg);
    border-color: var(--dennoko-semantic-info);
    border-width: 1px;
    border-radius: 4px;
    padding: 4px 6px;
    margin-top: 4px;
    margin-bottom: 4px;
}

.dennoko-root .item-version-text {
    font-size: 10px;
    color: var(--dennoko-text-primary);
    white-space: normal;
}

.dennoko-root .item-actions-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 4px;
}

.dennoko-root .item-actions-left {
    flex-direction: row;
    align-items: center;
}

.dennoko-root .mini-button {
    height: 22px;
    font-size: 10px;
    padding: 2px 8px;
    margin: 0 3px 0 0;
}

/* インポートボタン（通常・更新・再インポート）
   ※ 青枠 (semantic-info) は「選択中」を示す .dennoko-button-active 専用なので使わない */
.dennoko-root .import-button {
    min-width: 130px;
    height: 24px;
    font-size: 11px;
    -unity-font-style: bold;
    margin: 0;
}

.dennoko-root .import-button-new {
    color: var(--dennoko-text-primary);
}

.dennoko-root .import-button-update {
    border-color: var(--dennoko-semantic-warning);
    color: var(--dennoko-semantic-warning);
    background-color: var(--dennoko-status-warning-bg);
}

.dennoko-root .import-button-reimport {
    color: var(--dennoko-text-secondary);
}

/* ─── その他導入済みツールカード ───────────────────────── */
.dennoko-root .other-tools-header {
    margin-top: 10px;
    margin-bottom: 2px;
    padding: 4px 10px;
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--dennoko-text-primary);
    flex-shrink: 0;
}

/* ─── 空表示メッセージ ─────────────────────────────────── */
.dennoko-root .empty-message-card {
    background-color: var(--dennoko-surface-1);
    border-color: var(--dennoko-outline);
    border-width: 1px;
    border-radius: 6px;
    padding: 14px 12px;
    margin: 10px 8px;
    align-items: center;
}

.dennoko-root .empty-message-text {
    color: var(--dennoko-text-secondary);
    font-size: 11px;
    -unity-text-align: middle-center;
    white-space: normal;
}
